class Solution {
    public int kthSmallest(int[][] matrix, int target) {
        int m=matrix.length;
        int n=matrix[0].length;
        int[] arr=new int[m*n];
        int i=0,j1=0,j2=0,k=0;
        if(m==1){
            for(int x=0;x<n;x++){
            arr[k]=matrix[m-1][x];
            k++;}
            return arr[target-1];
        }
        int store=0;
        while(i<m-1){
            if(matrix[i][j1]<=matrix[i+1][j2]){
                arr[k]=matrix[i][j1];
                j1++;
                k++;
            }
            else{
                arr[k]=matrix[i+1][j2];
                j2++;
                store=j2;
                k++;
            }
            if(j1>matrix[0].length-1){
                i++;
                j1=0;
                j2=0;
            }
            
        }
        for(int x=store;x<n;x++){
            arr[k]=matrix[m-1][x];
            k++;
        }
        for(int z: arr){
            System.out.println(z);
        }
        return arr[target-1];
    }
